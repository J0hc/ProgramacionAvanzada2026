<div class="container mt-5" style="max-width:1200px;">

    <h1 class="dashboard-title text-center mb-4">
        Panel Administrativo
    </h1>

    <!-- MÉTRICAS -->
    <div class="row text-center mb-5">

        <div class="col-md-4">
            <div class="metric-card">
                <i class="bi bi-mortarboard-fill metric-icon"></i>
                <h2>@ViewBag.TotalCarreras</h2>
                <p>Carreras</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="metric-card">
                <i class="bi bi-journal-bookmark-fill metric-icon"></i>
                <h2>@ViewBag.TotalCursos</h2>
                <p>Cursos</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="metric-card">
                <i class="bi bi-person-badge-fill metric-icon"></i>
                <h2>@ViewBag.TotalProfesores</h2>
                <p>Profesores</p>
            </div>
        </div>

    </div>

    <!-- Acciones Rapidas de acceso -->
    <div class="d-flex justify-content-center gap-3 mb-5">

        <a asp-controller="Curso" asp-action="Create" class="btn btn-outline-success btn-sm">
            + Curso
        </a>

        <a asp-controller="Carreras" asp-action="Create" class="btn btn-outline-success btn-sm">
            + Carrera
        </a>

        <a asp-controller="Profesor" asp-action="Create" class="btn btn-outline-success btn-sm">
            + Profesor
        </a>

    </div>

    <!-- GRÁFICO -->
    <div class="card shadow-sm p-4 mb-5 mx-auto"
         style="height: 500px; max-width: 900px;">

        <h5 class="mb-4 text-center">Distribución del sistema</h5>

        <div class="d-flex justify-content-center align-items-center h-100">

            <canvas id="graficoSistema"
                    style="max-width: 350px; max-height: 350px;">
            </canvas>

        </div>

    </div>

    <!-- GESTIÓN  -->
    <div class="text-center">

        <a asp-controller="Carreras" asp-action="Index" class="link-dashboard">
            Gestionar Carreras
        </a> |

        <a asp-controller="Curso" asp-action="Index" class="link-dashboard">
            Gestionar Cursos
        </a> |

        <a asp-controller="Profesor" asp-action="Index" class="link-dashboard">
            Gestionar Profesores
        </a> |
        <a asp-controller="Admin" asp-action="Auditoria" class="link-dashboard">
            Gestionar Auditoria
        </a>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const ctx = document.getElementById('graficoSistema');

    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['Carreras', 'Cursos', 'Profesores'],
            datasets: [{
                data: [
                    @ViewBag.TotalCarreras,
                    @ViewBag.TotalCursos,
                    @ViewBag.TotalProfesores
                ]
            }]
        }
    });
</script>