@model IEnumerable<ProyectoFinal.Models.Auditoria>

<h2>Historial del sistema</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Usuario</th>
            <th>Acción</th>
            <th>Entidad</th>
            <th>Descripción</th>
            <th>Fecha</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.NombreUsuario</td>
                <td>@log.Accion</td>
                <td>@log.Entidad</td>
                <td>@log.Descripcion</td>
                <td>@log.Fecha</td>
            </tr>
        }
    </tbody>
</table>

<div class="form-footer">
    <a asp-controller="Admin"
       asp-action="Dashboard"
       class="btn btn-secondary">
        Volver
    </a>
</div>