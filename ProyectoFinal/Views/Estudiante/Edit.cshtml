@model ProyectoFinal.Models.ApplicationUser

<h1 class="dashboard-title">Editar Cuenta</h1>

<div class="form-container">

    <form asp-action="Edit" method="post" enctype="multipart/form-data">

        <div class="form-group">
            <label>Nombre</label>
            <input asp-for="NombreCompleto" class="form-input" />
        </div>

        <div class="form-group">
            <label>Correo</label>
            <input asp-for="Email" class="form-input" />
        </div>

        <div class="form-group">
            <label>Foto de Perfil</label>

            @if (!string.IsNullOrEmpty(Model.FotoUrl))
            {
                <img src="@Model.FotoUrl" style="width:100px; border-radius:50%; margin-bottom:10px;" />
            }

            <input type="file" name="foto" class="form-input" />
        </div>

        <div class="form-group">
            <label>Carrera</label>

            <select asp-for="CarreraId" class="form-input">
                @foreach (var c in ViewBag.Carreras)
                {
                    <option value="@c.Id">@c.Nombre</option>
                }
            </select>
        </div>

        <button type="submit" class="btn-main">
            Guardar Cambios
        </button>

    </form>

    <div class="form-footer">
        <a asp-action="Index">Volver</a>
    </div>

</div>

<script>
    const selectCarrera = document.querySelector("[name='CarreraId']");
    const form = document.querySelector("form");

    let carreraOriginal = selectCarrera.value;

    form.addEventListener("submit", function (e) {

        if (selectCarrera.value !== carreraOriginal) {

            let confirmar = confirm("Si cambias de carrera perderás todos tus cursos matriculados. ¿Deseas continuar?");

            if (!confirmar) {
                e.preventDefault();
            }
        }

    });
</script>