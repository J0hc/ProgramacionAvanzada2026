@model ProyectoFinal.Models.ApplicationUser

<h1 class="dashboard-title">
    Universidad De Programacion
</h1>

@if (Model != null)
{

    <!-- BIENVENIDA -->
    <div class="carrera-card">

        <div class="carrera-info">
            <h3>Bienvenido, @Model.NombreCompleto</h3>

            <p>
                Carrera: <strong>@Model.Carrera?.Nombre</strong>
            </p>
        </div>

    </div>

    <div style="display:flex; justify-content:center; margin:40px 0;">

        <div class="progress-container">

            <svg width="160" height="160">

                <!-- Fondo -->
                <circle cx="80" cy="80" r="70"
                        stroke="#eee"
                        stroke-width="12"
                        fill="none" />

                <!-- Progreso -->
                <circle cx="80" cy="80" r="70"
                        stroke="#4CAF50"
                        stroke-width="12"
                        fill="none"
                        stroke-dasharray="440"
                        stroke-dashoffset="@((440 - (440 * ViewBag.Progreso / 100)))"
                        stroke-linecap="round"
                        transform="rotate(-90 80 80)" />

            </svg>

            <div class="progress-text">
                <h2>@ViewBag.Progreso%</h2>
                <p>Progreso</p>
            </div>

        </div>

    </div>

    <p style="text-align:center;">
        @ViewBag.TotalCursos / @ViewBag.TotalCarrera cursos completados
    </p>

    <!-- BOTÓN REGISTRAR -->
    <div class="dashboard-actions">
        <a asp-controller="Matricula"
           asp-action="Index"
           class="btn btn-success">
            Registrar Cursos
        </a>
    </div>

    <div class="section-divider"></div>

    <!-- LOS CURSOS -->
    <h3 class="section-title">Tus cursos</h3>

    @if (Model.Matriculas != null && Model.Matriculas.Any())
    {
        foreach (var m in Model.Matriculas)
        {
            var curso = m.Curso;

            <div class="carrera-card d-flex align-items-center">

                @if (curso.ImagenUrl != null)
                {
                    <img src="@curso.ImagenUrl" class="carrera-img" />
                }

                <div class="carrera-info">
                    <h3>@curso.Nombre</h3>
                    <p>Créditos: @curso.Creditos</p>
                    <p>Profesor: @curso.Profesor?.NombreCompleto</p>
                </div>

                <!-- BOTÓN BORRAR -->
                <button class="btn btn-danger ms-auto"
                        style="background:#d9534f;"
                        onclick="ajaxPost(this)"
                        data-url="/Matricula/Delete"
                        data-id="@curso.Id">
                    Quitar
                </button>

            </div>
        }
    }
    else
    {
        <p style="text-align:center; margin-top:20px;">
            No tienes cursos matriculados.
        </p>
    }

}