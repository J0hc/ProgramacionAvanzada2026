@model Registro

@{
    ViewData["Title"] = "Registro Estudiante";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Register" method="post">

    <div asp-validation-summary="All" class="text-danger"></div>
    <div>
        <label>Nombre Completo</label>
        <input asp-for="NombreCompleto" />
        <span asp-validation-for="NombreCompleto"></span>
    </div>
    <div>
        <label>Email</label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div>
        <label>Contraseña</label>
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password"></span>
    </div>
    <div>
        <label>Confirmar Contraseña</label>
        <input asp-for="ConfirmPassword" type="password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.CarreraId)
        @Html.DropDownListFor(m => m.CarreraId, Model.Carreras, "-- Selecciona Una Carrera --", new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.CarreraId, "", new { @class = "text-danger" })
    </div>
    <button type="submit">Registrarse</button>
</form>