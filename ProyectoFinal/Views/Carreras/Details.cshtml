@model Carrera

<div class="form-container">

    <h2 class="form-title">@Model.Nombre</h2>
    <p class="form-subtitle">Información detallada de la carrera</p>

    <div class="form-group">
        <label>Nombre</label>
        <p>@Model.Nombre</p>
    </div>

    <div class="form-group">
        <label>Escuela</label>
        <p>@Model.Escuela</p>
    </div>

    @if (Model.ImagenUrl != null)
    {
        <div class="form-group" style="text-align: center;">
            <img src="@Model.ImagenUrl" class="carrera-img" style="width:200px; height:auto;" />
        </div>
    }


    <div class="form-footer">
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>

  </div>