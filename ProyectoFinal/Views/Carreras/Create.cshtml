@model Carrera

<div class="form-container">

    <h1 class="form-title">Agregar Carrera</h1>
     
    <form asp-action="Create" enctype="multipart/form-data" method="post">

        <div class="form-group">
            <label>Nombre</label>
            <input asp-for="Nombre" class="form-input" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Escuela</label>
            <input asp-for="Escuela" class="form-input" />
            <span asp-validation-for="Escuela" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Imagen</label>
            <input asp-for="Imagen" type="file" class="form-input" />
        </div>

        <button type="submit" class="btn btn-success center-btn">
            Guardar
        </button>

        <div class="form-footer">
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        </div>

    </form>

</div>