@model IEnumerable<Carrera>

<h2 class="section-title">Todas las carreras</h2>

<!--Para crear-->
<a asp-action="Create" class="btn-dashboard">
    Nueva Carrera
</a>

<br>
<br>

<!-- Mostrar carreras -->
@foreach (var item in Model)
{

    <div class="carrera-card">

        @if (item.ImagenUrl != null)
        {
            <img src="@item.ImagenUrl" class="carrera-img" />
        }

        <div class="carrera-info">

            <p>@item.Escuela</p>

            <h3>@item.Nombre</h3>

            <p>
                Carrera de @item.Nombre
            </p>

        </div>

        <a asp-action="Details"
           asp-route-id="@item.Id"
           class="btn-card">
            Detalles de la Carrera
        </a>

    </div>

}