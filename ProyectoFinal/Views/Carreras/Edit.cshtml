@model Carrera

<div class="form-container">

    <h2 class="form-title">Editar Carrera</h2>
    <p class="form-subtitle">Modifica la información de la carrera</p>

    <form asp-action="Edit" enctype="multipart/form-data">

        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label>Nombre</label>
            <input asp-for="Nombre" class="form-input" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Escuela</label>
            <input asp-for="Escuela" class="form-input" />
            <span asp-validation-for="Escuela" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Imagen</label>

            @if (!string.IsNullOrEmpty(Model.ImagenUrl))
            {
                <div style="text-align:center; margin-bottom:10px;">
                    <img src="@Model.ImagenUrl"
                         onerror="this.src='/images/default-user.png'"
                         style="width:120px; height:auto; border-radius:10px;" />
                </div>
            }
            <input asp-for="Imagen" type="file" class="form-input" />
        </div>

        <button type="submit" class="btn btn-success center-btn">
            Guardar Cambios
        </button>

        <div class="form-footer">
            <a asp-controller="Carreras"
               asp-action="Index"
               class="btn btn-secondary">
                Volver
            </a>
        </div>

    </form>

</div>