@{
    var foto = ViewBag.FotoUrl as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProyectoFinal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoFinal.styles.css" asp-append-version="true" />
</head>

<body>

    <header class="main-header">
        <div class="header-container">

            <div class="logo">
                <a asp-controller="Home" asp-action="Index">
                    Universidad Programación Avanzada
                </a>
            </div>

            <nav class="main-nav">

                <div style="display:flex; align-items:center; gap:15px;">

                   
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @* ADMIN *@
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="role-badge" style="color:white;">
                                <i class="bi bi-shield-lock-fill"></i> Admin
                            </span>
                        }

                  
                        @if (User.IsInRole("Estudiante"))
                        {
                            <div style="display:flex; align-items:center; gap:10px;">

                                <img src="@(string.IsNullOrEmpty(foto) ? "/images/default-user.png" : foto)"
                                     style="width:35px; height:35px; border-radius:50%; object-fit:cover;" />

                                <span class="role-badge role-estudiante">
                                    <i class="bi bi-mortarboard-fill"></i> Estudiante
                                </span>

                                <button class="btn-link-custom"
                                        data-bs-toggle="modal"
                                        data-bs-target="#miCuentaModal">
                                    Mi Cuenta
                                </button>

                            </div>
                        }
                    }

                </div>

            </nav>

        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

   <!--  Modal -->
    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Estudiante"))
    {
        <div class="modal fade" id="miCuentaModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Mi Cuenta</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">

                        <p><strong>Nombre:</strong> @ViewBag.Nombre</p>

                        <p>
                            <strong>Carrera:</strong>
                            @ViewBag.Carrera
                        </p>

                        <p>
                            <strong>Cursos matriculados:</strong>
                            @ViewBag.TotalCursos
                        </p>

                    </div>

                    <div class="modal-footer">

                        <button class="btn btn-secondary" data-bs-dismiss="modal">
                            Cerrar
                        </button>

                        <a asp-controller="Estudiante"
                           asp-action="Edit"
                           class="btn btn-primary">
                            Editar Cuenta
                        </a>

                    </div>

                </div>
            </div>
        </div>
    }

    <script>
        if (!sessionStorage.getItem("previousPage")) {
            sessionStorage.setItem("previousPage", document.referrer);
        }
    </script>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

