@model ProyectoFinal.Models.Profesor

<div class="form-container">

    <h1 class="form-title">Agregar Profesor</h1>

    <form asp-action="Create" method="post">

        <div class="form-group">
            <label asp-for="NombreCompleto"></label>
            <input asp-for="NombreCompleto" class="form-input" />
            <span asp-validation-for="NombreCompleto" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-input" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Especialidad"></label>
            <input asp-for="Especialidad" class="form-input" />
            <span asp-validation-for="Especialidad" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-main">
            Guardar
        </button>

        <div class="form-footer">
            <a asp-action="Index">Cancelar</a>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}