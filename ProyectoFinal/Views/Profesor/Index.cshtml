@model IEnumerable<ProyectoFinal.Models.Profesor>

<h2 class="section-title">Profesores</h2>

<a asp-action="Create" class="btn-dashboard">
    Agregar Profesor
</a>

<br />
<br />

<table class="admin-table">

    <thead>
        <tr>
            <th>Nombre</th>
            <th>Email</th>
            <th>Especialidad</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var profesor in Model)
        {
            <tr>

                <td>@profesor.NombreCompleto</td>

                <td>@profesor.Email</td>

                <td>@profesor.Especialidad</td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@profesor.Id"
                       class="btn-action btn-edit">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@profesor.Id"
                       class="btn-action btn-delete">
                        Eliminar
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>