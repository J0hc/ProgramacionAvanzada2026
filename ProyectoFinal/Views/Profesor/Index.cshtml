@model IEnumerable<ProyectoFinal.Models.Profesor>

<h2 class="section-title">Profesores</h2>

<a asp-action="Create" class="btn btn-success">
    Agregar Profesor
</a>

<br />
<br />

<table class="admin-table">

    <thead>
        <tr>
            <th>Nombre</th>
            <th>Email</th>
            <th>Especialidad</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var profesor in Model)
        {
            <tr>

                <td>@profesor.NombreCompleto</td>

                <td>@profesor.Email</td>

                <td>@profesor.Especialidad</td>

                <td>
                    <div class="card-actions">
                    <a asp-action="Edit"
                       asp-route-id="@profesor.Id"
                           class="btn btn-warning">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@profesor.Id"
                       class="btn btn-danger">
                        Eliminar
                    </a>
                </div>

                </td>

            </tr>
        }

    </tbody>

</table>

<div class="form-footer">
    <a asp-controller="Admin"
       asp-action="Dashboard"
       class="btn btn-secondary">
        Volver
    </a>
</div>