@model ProyectoFinal.Models.Profesor

<div class="form-container">

    <h2 class="form-title">Editar Profesor</h2>
    <p class="form-subtitle">Modifica la información del profesor</p>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="NombreCompleto"></label>
            <input asp-for="NombreCompleto" class="form-input" />
            <span asp-validation-for="NombreCompleto" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-input" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Especialidad"></label>
            <input asp-for="Especialidad" class="form-input" />
            <span asp-validation-for="Especialidad" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success center-btn">
            Actualizar
        </button>

        <div class="form-footer">
            <a asp-controller="Profesor"
               asp-action="Index"
               class="btn btn-secondary">
                Volver
            </a>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}