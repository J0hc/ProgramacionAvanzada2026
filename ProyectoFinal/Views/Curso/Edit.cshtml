@model ProyectoFinal.Models.Curso
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Editar Curso";
}

<div class="form-container">

    <h2 class="form-title">Editar Curso</h2>
    <p class="form-subtitle">Modifica la información del curso</p>

    <form asp-action="Edit" enctype="multipart/form-data" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" class="form-input" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Creditos"></label>
            <input asp-for="Creditos" class="form-input" />
            <span asp-validation-for="Creditos" class="text-danger"></span>
        </div>

        <!-- Carrera -->
        <div class="form-group">
            <label asp-for="CarreraId"></label>
            <select asp-for="CarreraId" class="form-input" asp-items="ViewBag.Carreras">
                <option value="">-- Seleccione una carrera --</option>
            </select>
            <span asp-validation-for="CarreraId" class="text-danger"></span>
        </div>

        <!-- Profesor -->
        <div class="form-group">
            <label asp-for="ProfesorId"></label>
            <select asp-for="ProfesorId" class="form-input" asp-items="ViewBag.Profesores">
                <option value="">-- Seleccione un profesor --</option>
            </select>
            <span asp-validation-for="ProfesorId" class="text-danger"></span>
        </div>

        <!-- Imagen actual -->
        <div class="form-group">
            <label>Imagen Actual</label>

            @if (!string.IsNullOrEmpty(Model.ImagenUrl))
            {
                <div style="text-align:center; margin-bottom:10px;">
                    <img src="@Model.ImagenUrl" class="carrera-img" style="width:150px; height:auto;" />
                </div>
            }
            else
            {
                <p style="text-align:center;">No hay imagen</p>
            }
        </div>

        <!-- Nueva imagen -->
        <div class="form-group">
            <label asp-for="Imagen">Cambiar Imagen</label>
            <input asp-for="Imagen" type="file" class="form-input" />
            <span asp-validation-for="Imagen" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success center-btn">
            Guardar Cambios
        </button>

        <div class="form-footer">
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}