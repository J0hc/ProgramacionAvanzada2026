@model ProyectoFinal.Models.Curso

@{
    ViewData["Title"] = "Eliminar Curso";
}

<h2>Eliminar Curso</h2>

<h3>¿Estás seguro que deseas eliminar este curso?</h3>

<div>
    <h4>@Model.Nombre</h4>
    <dl class="row">
        <dt class="col-sm-2">Créditos</dt>
        <dd class="col-sm-10">@Model.Creditos</dd>

        <dt class="col-sm-2">Imagen</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.ImagenUrl))
            {
                <img src="@Model.ImagenUrl" width="150" />
            }
            else
            {
                <p>No hay imagen</p>
            }
        </dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger center-btn">Eliminar</button>
</form>

<div class="form-footer">
    <a asp-controller="Curso"
       asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>
</div>