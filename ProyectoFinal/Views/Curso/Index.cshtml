@model IEnumerable<ProyectoFinal.Models.Curso>

<h2 class="section-title">Cursos</h2>

<a asp-action="Create" class="btn-dashboard">
    Nuevo Curso
</a>

<br />
<br />

<table class="admin-table">

    <thead>
        <tr>
            <th>Nombre</th>
            <th>Créditos</th>
            <th>Imagen</th>
            <th>Profesor</th>
            <th>Carrera</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Nombre</td>

                <td>@item.Creditos</td>

                <td>
                    @if (!string.IsNullOrEmpty(item.ImagenUrl))
                    {
                        <img src="@item.ImagenUrl" />
                    }
                </td>

                <td>@item.Profesor?.NombreCompleto</td>

                <td>@item.Carrera?.Nombre</td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn-action btn-edit">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn-action btn-delete">
                        Eliminar
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>